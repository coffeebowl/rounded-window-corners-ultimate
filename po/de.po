#: extension/preferences/pages/blacklist.ui:6
#: extension/preferences/pages/blacklist.ui:10
msgid "Blacklist / Whitelist"
msgstr "Ausschlüsse / Positivliste"

#: extension/preferences/pages/blacklist.ui:11
msgid ""
"Not all application can works well with rounded corners effects, add them to "
"this list to disable effects."
msgstr ""
"Nicht alle Anwendungen vertragen abgerundete Ecken. Für Anwendungen in "
"dieser Liste ist der Effekt abgeschaltet."

#: extension/preferences/pages/blacklist.ui:14
msgid "Use as Whitelist"
msgstr "Als Positivliste verwenden"

#: extension/preferences/pages/blacklist.ui:15
msgid ""
"When selected, instead of omitting certain windows, only allows certain "
"windows."
msgstr "Statt die aufgeführten Fenster auszulassen, werden nur sie abgerundet."

#: extension/preferences/pages/blacklist.ui:25
#: extension/preferences/pages/custom.ui:19
msgid "Add window"
msgstr "Fenster hinzufügen"

#: extension/preferences/pages/custom.ui:6
#: extension/preferences/pages/custom.ui:10
msgid "Custom"
msgstr "Benutzerdefiniert"

#: extension/preferences/pages/custom.ui:11
msgid "Set custom effect setting for each window class"
msgstr "Eigene Einstellungen pro Fensterklasse festlegen"

#: extension/preferences/pages/edit-shadow.ui:6
msgid "Edit shadows"
msgstr "Schatten bearbeiten"

#: extension/preferences/pages/edit-shadow.ui:28
msgid "Focused window"
msgstr "Fokussiertes Fenster"

#: extension/preferences/pages/edit-shadow.ui:43
msgid "Unfocused window"
msgstr "Nicht fokussiertes Fenster"

#: extension/preferences/pages/edit-shadow.ui:66
msgid "Focused shadow preferences"
msgstr "Schatten fokussierter Fenster"

#: extension/preferences/pages/edit-shadow.ui:69
#: extension/preferences/pages/edit-shadow.ui:209
msgid "Horizontal offset"
msgstr "Horizontaler Versatz"

#: extension/preferences/pages/edit-shadow.ui:96
#: extension/preferences/pages/edit-shadow.ui:236
msgid "Vertical offset"
msgstr "Vertikaler Versatz"

#: extension/preferences/pages/edit-shadow.ui:123
#: extension/preferences/pages/edit-shadow.ui:263
msgid "Blur radius"
msgstr "Unschärferadius"

#: extension/preferences/pages/edit-shadow.ui:150
#: extension/preferences/pages/edit-shadow.ui:290
msgid "Spread radius"
msgstr "Ausbreitung"

#: extension/preferences/pages/edit-shadow.ui:177
#: extension/preferences/pages/edit-shadow.ui:317
msgid "Opacity"
msgstr "Deckkraft"

#: extension/preferences/pages/edit-shadow.ui:206
msgid "Unfocused shadow preferences"
msgstr "Schatten nicht fokussierter Fenster"

#: extension/preferences/pages/general.ui:6
msgid "General"
msgstr "Allgemein"

#: extension/preferences/pages/general.ui:10
msgid "Applications"
msgstr "Anwendungen"

#: extension/preferences/pages/general.ui:11
msgid ""
"Some applications created with LibAdwaita or LibHandy already have rounded "
"corners. You can enable those settings to avoid rounding their corners an "
"extra time."
msgstr ""
"Manche Anwendungen mit LibAdwaita oder LibHandy haben bereits abgerundete "
"Ecken. Mit diesen Einstellungen werden sie nicht ein zweites Mal abgerundet."

#: extension/preferences/pages/general.ui:14
msgid "Skip LibAdwaita applications"
msgstr "LibAdwaita-Anwendungen auslassen"

#: extension/preferences/pages/general.ui:19
msgid "Skip LibHandy applications"
msgstr "LibHandy-Anwendungen auslassen"

#: extension/preferences/pages/general.ui:26
msgid "Global settings"
msgstr "Globale Einstellungen"

#: extension/preferences/pages/general.ui:27
msgid "These settings will have an effect on all windows"
msgstr "Diese Einstellungen gelten für alle Fenster"

#: extension/preferences/pages/general.ui:30
msgid "Border width"
msgstr "Rahmenbreite"

#: extension/preferences/pages/general.ui:57
#: extension/preferences/pages/general.ui:65
#: extension/preferences/widgets/custom_settings_row.js:18
msgid "Border color"
msgstr "Rahmenfarbe"

#: extension/preferences/pages/general.ui:74
#: extension/preferences/widgets/custom_settings_row.js:26
msgid "Corner radius"
msgstr "Eckenradius"

#: extension/preferences/pages/general.ui:101
#: extension/preferences/widgets/custom_settings_row.js:36
msgid "Corner smoothing"
msgstr "Eckenglättung"

#: extension/preferences/pages/general.ui:127
msgid "Window shadow"
msgstr "Fensterschatten"

#: extension/preferences/pages/general.ui:128
msgid "Customize the shadow of the rounded corner window"
msgstr "Passe den Schatten von Fenstern mit abgerundeten Ecken an"

#: extension/preferences/pages/general.ui:140
msgid "Keep shadows for maximized and fullscreen windows"
msgstr "Schatten für maximierte und Vollbild-Fenster behalten"

#: extension/preferences/pages/general.ui:145
msgid "Keep rounded corners for maximized windows"
msgstr "Abgerundete Ecken für maximierte Fenster behalten"

#: extension/preferences/pages/general.ui:150
msgid "Keep rounded corners for fullscreen windows"
msgstr "Abgerundete Ecken für Vollbild-Fenster behalten"

#: extension/preferences/pages/general.ui:160
msgid "Tweaks"
msgstr "Optimierungen"

#: extension/preferences/pages/general.ui:163
msgid "Add rounded corners to Kitty Terminal on Wayland"
msgstr "Kitty-Terminal unter Wayland abrunden"

#: extension/preferences/pages/general.ui:164
msgid "Adjust paddings for Kitty Terminal to correctly round its corners"
msgstr ""
"Passt die Abstände an, damit die Ecken von Kitty richtig abgerundet werden"

#: extension/preferences/pages/general.ui:171
msgid "Debug"
msgstr "Debug"

#: extension/preferences/pages/general.ui:174
msgid "Enable debug logs"
msgstr "Debug-Ausgaben aktivieren"

#: extension/preferences/pages/general.ui:175
msgid ""
"Run journalctl -o cat -f /usr/bin/gnome-shell in your terminal to see the log"
msgstr ""
"Im Terminal journalctl -o cat -f /usr/bin/gnome-shell ausführen, um die "
"Ausgaben zu sehen"

